# === CORE API KEYS ===
GEMINI_API_KEY=your-google-gemini-api-key-here

# === WHATSAPP MCP CONFIGURATION ===
MCP_SERVER_URL=http://localhost:3334
MCP_POLL_INTERVAL=3

# === BOT BEHAVIOR SETTINGS ===
BOT_NAME=AI Assistant
BOT_TRIGGERS=/ask,@bot,!ai,>
AUTHORIZED_NUMBERS=+1234567890,+0987654321
ENABLE_GROUP_CHATS=true
ENABLE_PERSONAL_CHATS=true

# === AGENT SETTINGS ===
MAX_RESPONSE_LENGTH=500
AGENT_TEMPERATURE=0.7
AGENT_MODEL=gemini-2.5-flash-lite-preview-06-17

# === LOGGING & DEBUG ===
LOG_LEVEL=INFO
ENABLE_CONSOLE_LOGS=true
ENABLE_FILE_LOGS=true

# === STREAMLIT DASHBOARD ===
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost 