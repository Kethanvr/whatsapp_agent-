# Streamlit Dashboard - Lightweight Container
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Set working directory
WORKDIR /app

# Copy dashboard requirements
COPY requirements.txt .

# Install only dashboard-related dependencies
RUN pip install --no-cache-dir \
    streamlit \
    streamlit-autorefresh \
    loguru \
    python-dotenv \
    requests

# Copy dashboard code
COPY --chown=appuser:appuser dashboard/ ./dashboard/
COPY --chown=appuser:appuser config/ ./config/
COPY --chown=appuser:appuser run_dashboard.py .

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8502

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8502/health || exit 1

# Start dashboard
CMD ["streamlit", "run", "run_dashboard.py", "--server.port=8502", "--server.address=0.0.0.0", "--server.headless=true"] 