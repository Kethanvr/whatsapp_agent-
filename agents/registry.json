{
  "agents": [
    {
      "id": "qna-chatbot",
      "name": "WhatsApp Q&A Assistant",
      "description": "Concise question answering for WhatsApp messages",
      "capabilities": [
        "general-qa",
        "factual-questions",
        "explanations",
        "definitions",
        "reasoning",
        "whatsapp-responses"
      ],
      "model": "gemini-2.5-flash",
      "temperature": 0.7,
      "max_tokens": 300,
      "enabled": true,
      "priority": 1,
      "response_format": {
        "style": "concise",
        "max_paragraphs": 3,
        "use_bullet_points": true,
        "whatsapp_friendly": true
      }
    },
    {
      "id": "memory-store",
      "name": "Memory Store Agent",
      "description": "Stores and retrieves user memories based on requests like 'remember this' or 'recall'.",
      "capabilities": ["memory-store", "memory-retrieve"],
      "memory_url": "http://localhost:8090",
      "enabled": true,
      "keywords": ["remember", "recall", "memory", "store"]
    }
  ],
  "routing_rules": {
    "default_agent": "qna-chatbot",
    "keywords": {
      "qna-chatbot": [
        "what",
        "how",
        "why",
        "explain",
        "define",
        "tell me",
        "help",
        "question",
        "answer",
        "ask",
        "info",
        "information",
        "hi",
        "hello",
        "hey"
      ],
      "memory-store": ["remember", "recall", "memory", "store"]
    }
  },
  "system_config": {
    "max_retries": 3,
    "timeout_seconds": 30,
    "fallback_agent": "qna-chatbot",
    "response_guidelines": {
      "prefer_short_answers": true,
      "max_response_length": 300,
      "use_emojis": false,
      "format_for_mobile": true
    }
  }
}
